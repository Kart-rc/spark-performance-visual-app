# Gemini AI API Key (for coaching assistance)
VITE_GEMINI_API_KEY=your_api_key_here

# OpenTelemetry Configuration
# Enable/disable exporters (set to "true" to enable)
VITE_ENABLE_JAEGER=false
VITE_ENABLE_OTLP=true

# Jaeger endpoint (if VITE_ENABLE_JAEGER=true)
VITE_JAEGER_ENDPOINT=http://localhost:14268/api/traces

# OTLP endpoint for Grafana/Tempo (if VITE_ENABLE_OTLP=true)
VITE_OTLP_ENDPOINT=http://localhost:4318/v1/traces
